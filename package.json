{
  "name": "@hibira-io/waiting-room",
  "version": "0.2.0",
  "description": "Virtual waiting room for ticket drops and launches on Hibira: check the signed pass at the edge (Cloudflare Workers, Next.js middleware, Express) and build custom queue pages",
  "keywords": [
    "waiting-room",
    "virtual-queue",
    "queue",
    "ticketing",
    "flash-sale",
    "rate-limit",
    "cloudflare-workers",
    "nextjs-middleware",
    "express",
    "pusher",
    "realtime",
    "hibira"
  ],
  "homepage": "https://hibira.io",
  "bugs": {
    "url": "https://github.com/hibira-io/waiting-room/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/waiting-room.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "server.js",
    "server.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.e2e.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
